{
  "name": "dsh-workspace-cake",
  "version": "0.2.0",
  "private": false,
  "description": "One bundle for the workspace list: right-click shortcuts, workspace pinning with a faint divider, and recency ordering of workspace groups.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "icon": "./icon.svg",
  "license": "MIT"
}
